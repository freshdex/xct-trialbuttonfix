{
  "manifest_version": 3,
  "name": "Xbox Store Button Injector",
  "version": "1.6",
  "minimum_chrome_version": "111",
  "description": "Injects a GET Free Trial button on Xbox Store product pages and opens the hidden XBOX Playback page.",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://emerald.xboxservices.com/*",
    "https://*.xboxlive.com/*",
    "https://www.xbox.com/*",
    "https://www.microsoft.com/*",
    "https://displaycatalog.mp.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xbox.com/*"],
      "js": ["playback.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.xbox.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}